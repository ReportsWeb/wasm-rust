server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location = /config.js {
    default_type application/javascript;
    return 200 'window.REPORTS_REST_SAMPLE={language:"${REPORTS_LANGUAGE}",api:"/report-api",preview:"/preview/"};';
  }

  location = /report-api {
    proxy_pass ${REPORTS_API_URL}$is_args$args;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 95s;
    # 4 つのサーバーと各言語のサンプルで同じ 64MiB（2026-10-13 決定）。超えた分はアプリが日本語の 413 で答えるよう、少し大きくする。
    client_max_body_size 65m;
  }

  location /preview/ {
    proxy_pass ${REPORTS_PREVIEW_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  location /demo/reports.web/ {
    proxy_pass ${REPORTS_APP_URL}/demo/reports.web/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  location / { try_files $uri $uri/ /index.html; }
}
